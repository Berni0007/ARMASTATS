# Секрет для мода. Тот же токен пишется в config.json мода.
STATS_TOKEN=CHANGE_ME

# Discord-бот. Без DISCORD_TOKEN сервис работает, но в Discord ничего не шлёт.
DISCORD_TOKEN=
# ID сервера Discord: на нём регистрируются команды /stats и /top
DISCORD_GUILD_ID=
# ID канала для отчётов о матчах
DISCORD_CHANNEL_ID=

# Отчёт шлётся, только если матч длился не меньше N секунд и в нём было не меньше M игроков
MATCH_REPORT_MIN_SEC=60
MATCH_REPORT_MIN_PLAYERS=1
